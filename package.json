{
  "name": "sss-company",
  "version": "1.0.0",
  "description": "SSS Company - Production ERP (API + Web)",
  "private": true,
  "scripts": {
    "comment:LOCAL_SETUP": "=== LOCAL DEVELOPMENT (NO DOCKER) ===",
    "setup:local": "if [ \"$OSTYPE\" = \"msys\" ] || [ \"$OSTYPE\" = \"win32\" ]; then powershell -ExecutionPolicy Bypass -File setup-local.ps1; else chmod +x setup-local.sh && ./setup-local.sh; fi",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd apps/api && npm run start:dev",
    "dev:web": "cd apps/web && npm run dev",
    "dev:api-only": "cd apps/api && npm run start:dev",
    "build:all": "npm run build:api && npm run build:web",
    "build:api": "cd apps/api && npm run build",
    "build:web": "cd apps/web && npm run build",
    "comment:DATABASE": "=== DATABASE MANAGEMENT ===",
    "db:setup": "cd apps/api && npx prisma migrate deploy && npx prisma db seed",
    "db:migrate": "cd apps/api && npx prisma migrate dev",
    "db:seed": "cd apps/api && npx prisma db seed",
    "db:studio": "cd apps/api && npx prisma studio",
    "db:reset": "cd apps/api && npx prisma migrate reset --force",
    "comment:DOCKER": "=== DOCKER DEPLOYMENT ===",
    "docker:full": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:whatsapp": "docker-compose -f docker-compose.whatsapp-only.yml up -d --build",
    "docker:whatsapp:down": "docker-compose -f docker-compose.whatsapp-only.yml down",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:api": "docker-compose logs -f api",
    "docker:logs:db": "docker-compose logs -f db",
    "docker:logs:whatsapp": "docker-compose -f docker-compose.whatsapp-only.yml logs -f whatsapp",
    "comment:LINT": "=== LINTING & FORMATTING ===",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "cd apps/api && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "comment:TEST": "=== TESTING ===",
    "test": "npm run test:api && npm run test:web",
    "test:api": "cd apps/api && npm test",
    "test:api:watch": "cd apps/api && npm run test:watch",
    "test:api:cov": "cd apps/api && npm run test:cov",
    "test:e2e": "cd apps/api && npm run test:e2e",
    "comment:PROD": "=== PRODUCTION ===",
    "start:api": "cd apps/api && npm run start:prod",
    "start:web": "cd apps/web && npm start"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
