DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sss?schema=public"

JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"

SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="admin@sss.com"
SUPERADMIN_PASSWORD="ChangeMe123!"

# --- WhatsApp (whatsapp-web.js, runs in-process) ---------------------------
# Set to "false" to disable the integration entirely (no browser launched).
WHATSAPP_ENABLED="true"
# Where the paired WhatsApp session is persisted (mount a volume here in prod).
WWEBJS_AUTH_PATH=".wwebjs_auth"
# Only needed in Docker where a system Chromium is used instead of the bundled one.
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# Anti-spam guardrails (transactional-only, no bulk sending — see whatsapp-queue.ts)
WHATSAPP_MIN_DELAY_MS=4000
WHATSAPP_MAX_DELAY_MS=9000
WHATSAPP_MAX_PER_RECIPIENT_PER_DAY=5
WHATSAPP_MAX_PER_HOUR=30
WHATSAPP_MAX_QUEUE_DEPTH=50
