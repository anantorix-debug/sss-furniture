# ============================================================================
# LOCAL DEVELOPMENT SETUP (Non-Docker)
# ============================================================================
# Copy this file to .env.local and update values as needed
# This setup runs API and DB locally without Docker

# Database (local MySQL)
DATABASE_URL="mysql://root:root@localhost:3306/sss"
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/sss"  # Alternative

# API Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3001,http://localhost:3000"

# JWT Secrets (CHANGE IN PRODUCTION!)
JWT_ACCESS_SECRET="dev-access-secret-change-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Super Admin (auto-created on first run if not exists)
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="admin@sss.com"
SUPERADMIN_PASSWORD="ChangeMe123!"

# ============================================================================
# WhatsApp Web.js (Session-based with local chromium/puppeteer)
# ============================================================================
WHATSAPP_ENABLED="true"
WWEBJS_AUTH_PATH=".wwebjs_auth"
# Uncomment only if you have custom chromium path (usually not needed locally)
# PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"
# Set to true to skip downloading bundled chromium (use system version)
# PUPPETEER_SKIP_DOWNLOAD="false"

# WhatsApp Rate Limiting (anti-spam guardrails)
WHATSAPP_MIN_DELAY_MS=4000
WHATSAPP_MAX_DELAY_MS=9000
WHATSAPP_MAX_PER_RECIPIENT_PER_DAY=5
WHATSAPP_MAX_PER_HOUR=30
WHATSAPP_MAX_QUEUE_DEPTH=50
WHATSAPP_SEND_TIMEOUT_MS=30000
WHATSAPP_LID_RESOLUTION_TIMEOUT_MS=8000
