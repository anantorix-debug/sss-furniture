generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Roles
// ---------------------------------------------------------------------------

enum Role {
  SUPERADMIN
  ADMIN
  CARPENTER
  CARVER
  POLISHER
}

enum DeliveryStatus {
  PENDING
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
}

// Structured payment stage - matches the original tracking sheet's
// ADVANCE | DATE-RECEIVED | BALANCE columns instead of relying on someone
// typing "Advance" into a free-text note. Auto-suggested by the service
// (first payment -> ADVANCE, one that zeroes the balance -> BALANCE,
// anything in between -> PARTIAL) but always overridable by whoever logs it.
enum PaymentType {
  ADVANCE
  PARTIAL
  BALANCE
  FULL
}

enum WorkStatus {
  ASSIGNED
  IN_PROGRESS
  QUALITY_CHECK
  REWORK
  COMPLETED
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  APPROVED
  SENT_TO_SHOP
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum WorkerType {
  CARPENTER
  POLISHER
  CARVER
}

// Lightweight customer-confirmation tracking for the catalogue-share flow.
// Deliberately separate from DeliveryStatus (a post-production concept) -
// this tracks the pre-production "did the customer agree to this product"
// step.
enum CatalogueStatus {
  NOT_SENT
  SENT
  CONFIRMED
}

// Which trade a production stage belongs to - drives the Job Number's
// Carpenter -> (optional Carving) -> Polish pipeline.
enum ProductionStageType {
  CARPENTER
  CARVING
  POLISH
}

// Which team a raw material belongs to, for visibility + who may record
// stock-in (Carpenter team handles WOOD, Polish team handles POLISH).
enum MaterialGroup {
  WOOD
  CARVING
  POLISH
  OTHER
}

// Which physical quantity a material is bought/sold in - separate from
// MaterialGroup (which team uses it: e.g. Plywood is WOOD group but SHEET
// kind). Drives which purchase-math fields the Suppliers "Add Purchase"
// form shows and the material's locked unit. BOARD_FEET -> Thickness x
// Width x Length x Pieces / 144; SHEET -> plain count; LIQUID -> Litre/Kg/
// Gram; COUNT -> Nos; OTHER -> today's free-text UnitSelect, unchanged.
enum MaterialMeasurementKind {
  BOARD_FEET
  SHEET
  LIQUID
  COUNT
  OTHER
}

enum QcResult {
  PASSED
  FAILED
  REWORK_REQUIRED
}

enum FinishedStockStatus {
  AVAILABLE
  RESERVED
  DISPATCHED
}

enum LabourStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// Which trigger created a CarpenterWorkItem - drives the completion-time
// bridge into stock (STOCK -> Product.availableQuantity) vs. an order
// (CUSTOMER_ORDER/PARTY_ORDER -> FinishedStockItem for that job, never
// double-counted as free stock). See CarpenterService.updateWorkStatus.
enum ProductionSource {
  CUSTOMER_ORDER
  PARTY_ORDER
  STOCK
}

enum StockOrderType {
  CUSTOMER
  PARTY
}

enum ProductStockMovementType {
  IN
  RESERVED
  RELEASED
  DISPATCHED
  ADJUSTMENT
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  password         String
  role             Role     @default(CARPENTER)
  isActive         Boolean  @default(true)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  customerOrders               CustomerOrder[]
  customerOrdersDelivered      CustomerOrder[]        @relation("CustomerOrderDeliveredBy")
  customerOrderPayments        CustomerOrderPayment[]
  partyOrders                  PartyOrder[]
  partyOrderPayments           PartyOrderPayment[]
  supplierPurchases            SupplierPurchase[]
  supplierPayments             SupplierPayment[]
  carpenterWorkItems           CarpenterWorkItem[]
  workItemsAssigned            CarpenterWorkItem[]    @relation("WorkItemAssignedBy")
  notifications                Notification[]
  carpenterProfile              Carpenter?
  carpenterPayments            CarpenterPayment[]
  stockMovements               StockMovement[]
  purchaseOrdersCreated        PurchaseOrder[]        @relation("PurchaseOrderCreatedBy")
  purchaseOrdersApproved       PurchaseOrder[]        @relation("PurchaseOrderApprovedBy")
  auditLogs                    AuditLog[]
  qualityChecks                QualityCheck[]
  dispatchRecords              DispatchRecord[]
  weeklyLaboursSubmitted       WeeklyLabour[]         @relation("WeeklyLabourSubmittedBy")
  weeklyLaboursReviewed        WeeklyLabour[]         @relation("WeeklyLabourReviewedBy")
  expensesCreated              Expense[]              @relation("ExpenseCreatedBy")
  expensesUpdated              Expense[]              @relation("ExpenseUpdatedBy")
  expenseAuditLogs             ExpenseAuditLog[]
  whatsappGroupSettingsUpdated WhatsappGroupSetting[]
  productionTeamsHeaded        ProductionTeam[]       @relation("ProductionTeamHead")

  customerOrdersAssigned        CustomerOrder[]        @relation("CustomerOrderAssignedEmployee")
  customerOrdersAssignedBy      CustomerOrder[]        @relation("CustomerOrderAssignedBy")
  customerOrdersModelNoUpdated  CustomerOrder[]        @relation("CustomerOrderModelNoUpdatedBy")
  partyOrdersAssigned           PartyOrder[]           @relation("PartyOrderAssignedEmployee")
  partyOrdersAssignedBy         PartyOrder[]           @relation("PartyOrderAssignedBy")
  partyOrdersModelNoUpdated     PartyOrder[]           @relation("PartyOrderModelNoUpdatedBy")
  partyOrderItemsModelNoUpdated PartyOrderItem[]       @relation("PartyOrderItemModelNoUpdatedBy")
  productStockMovements         ProductStockMovement[]
  galleryImages                 GalleryImage[]

  @@map("users")
}

// A WhatsApp group chat (id like "1203630XXXX-XXXXXXXXXX@g.us") to notify,
// per worker type, in addition to the individual worker's own number - so
// the whole Carpenter/Polish team sees every work assignment, not just the
// one person it's assigned to.
model WhatsappGroupSetting {
  id          String     @id @default(cuid())
  workerType  WorkerType @unique
  groupId     String
  groupName   String?
  updatedById String?
  updatedBy   User?      @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  @@map("whatsapp_group_settings")
}

// ---------------------------------------------------------------------------
// Sheet 1: Customer Order Tracking
// ---------------------------------------------------------------------------

model CustomerOrder {
  id                   String         @id @default(cuid())
  orderId              String         @unique // e.g. SSS-074
  jobNumber            String?        @unique // e.g. JOB-2026-00001 - the single ID tying order -> production -> dispatch -> delivery
  orderDate            DateTime
  customerName         String
  phone                String?
  whatsapp             String?
  address              String?
  deliveryLocation     String?
  product              String
  // Dimensions kept separate from the free-text product name/description
  // (e.g. size "78x72", sizeUnit "Inch") so they can be shown, filtered, and
  // put into WhatsApp templates as their own field rather than parsed out
  // of a string like "Z-Model 78*72 -BC -COT".
  size                 String?
  sizeUnit             String?
  colour               String?
  carvingRequired      Boolean        @default(false)
  specialInstructions  String?
  orderValue           Decimal        @db.Decimal(12, 2)
  cotTrack             String?
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  deliveryStatus       DeliveryStatus @default(PENDING)
  deliveredById        String?
  deliveredBy          User?          @relation("CustomerOrderDeliveredBy", fields: [deliveredById], references: [id])
  proofOfDeliveryUrl   String?
  deliveryRemarks      String?

  // Reference-only links to existing Gallery images selected for this
  // order (spec: never re-uploaded/duplicated - just a reference).
  galleryImages CustomerOrderGalleryImage[]

  // Model No workflow: Super Admin assigns a production employee, who is
  // then solely responsible for entering cotTrack (the Model No) - Super
  // Admin never sets cotTrack directly at creation or edit time.
  assignedEmployeeId String?
  assignedEmployee   User?     @relation("CustomerOrderAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedAt         DateTime?
  assignedById       String?
  assignedBy         User?     @relation("CustomerOrderAssignedBy", fields: [assignedById], references: [id])
  modelNoUpdatedById String?
  modelNoUpdatedBy   User?     @relation("CustomerOrderModelNoUpdatedBy", fields: [modelNoUpdatedById], references: [id])
  modelNoUpdatedAt   DateTime?

  // Catalogue-share / customer-confirmation tracking (see CatalogueStatus).
  catalogueStatus     CatalogueStatus @default(NOT_SENT)
  catalogueShareToken String?         @unique

  createdById String
  createdBy   User                   @relation(fields: [createdById], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  payments    CustomerOrderPayment[]
  items       CustomerOrderItem[]
  workItems   CarpenterWorkItem[]
  finishedStockItems FinishedStockItem[]

  @@map("customer_orders")
}

// Optional line items for an order with more than one product. When present,
// they're the source of truth for CustomerOrder.product (a joined summary)
// and .orderValue (their sum) - kept for backward compatibility with
// existing single-product orders, reports, and the search/track feature.
model CustomerOrderItem {
  id          String        @id @default(cuid())
  orderId     String
  order       CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Optional link back to the catalogue product this line was created
  // from - productName/unitPrice above are already a point-in-time
  // snapshot (copied at creation, not live-joined), so editing the
  // catalogue product later never changes historical order data. This FK
  // is purely for traceability ("which catalogue product was this").
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  category    String?
  size        String?
  sizeUnit    String?
  // Pre-set at order creation so the sequential Carpenter -> Carving ->
  // Polish handoff can auto-carry it to the Polish stage's work item -
  // the polisher then already knows the colour without an Admin having to
  // notice and fill it in later. See CarpenterService's stage handoff.
  color       String?
  quantity    Int           @default(1)
  unitPrice   Decimal       @db.Decimal(12, 2)

  // Stock-first allocation split, computed once at create/edit time by
  // StockAllocationService.allocate() - see CustomerOrdersService.
  stockReservedQty Int @default(0)
  productionQty    Int @default(0)

  workItems          CarpenterWorkItem[]
  finishedStockItems FinishedStockItem[]

  @@map("customer_order_items")
}

model CustomerOrderPayment {
  id      String        @id @default(cuid())
  orderId String
  order   CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date    DateTime
  amount  Decimal       @db.Decimal(12, 2)
  type    PaymentType   @default(PARTIAL)
  mode    String? // UPI / CASH / GPAY / ...
  note    String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("customer_order_payments")
}

// ---------------------------------------------------------------------------
// Sheet 5: Party Order Tracking (shop / wholesale orders)
// ---------------------------------------------------------------------------

model PartyOrder {
  id                 String         @id @default(cuid())
  cotNo              String?
  jobNumber          String?        @unique // e.g. JOB-2026-00001 - shares one sequence with CustomerOrder.jobNumber
  orderDate          DateTime
  shopName           String
  // Preferred going forward - the create form now sources shops from the
  // Shop directory and sends both this and a shopName snapshot together.
  // shopName alone stays valid for legacy rows, matching the same
  // "snapshot + optional FK" pattern already used for productId below.
  shopId             String?
  shop               Shop?          @relation(fields: [shopId], references: [id], onDelete: SetNull)
  phone              String?
  // Legacy single-product fields - required on old rows, left unset (null)
  // on new multi-line orders where `items` is the source of truth. Same
  // "kept for backward compatibility, never migrated" rule as
  // CustomerOrder.product/orderValue vs. CustomerOrderItem.
  model              String?
  // See the identical note on CustomerOrder.size/sizeUnit.
  size               String?
  sizeUnit           String?
  finish             String?
  details            String?
  qty                Int?
  price              Decimal?       @db.Decimal(12, 2)
  totalAmount        Decimal        @db.Decimal(12, 2)
  cashTrack          String? // internal cash-handler note, e.g. "CASH" / "SSS" - retired from create/update DTOs and the UI; column kept for old rows
  courierTrack       String? // delivery agent, e.g. Sitaram / Sunil
  actualDeliveryDate DateTime?
  deliveryStatus     DeliveryStatus @default(PENDING)

  // Optional link to the catalogue product this order's `model` field was
  // populated from (a Party Order has no line-items table, so the
  // reference lives directly on the order). model/price/finish above are
  // already a snapshot copied at creation time.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Same Model No workflow as CustomerOrder: Super Admin assigns a
  // production employee, who alone enters cotNo (the Model No).
  assignedEmployeeId String?
  assignedEmployee   User?     @relation("PartyOrderAssignedEmployee", fields: [assignedEmployeeId], references: [id])
  assignedAt         DateTime?
  assignedById       String?
  assignedBy         User?     @relation("PartyOrderAssignedBy", fields: [assignedById], references: [id])
  modelNoUpdatedById String?
  modelNoUpdatedBy   User?     @relation("PartyOrderModelNoUpdatedBy", fields: [modelNoUpdatedById], references: [id])
  modelNoUpdatedAt   DateTime?

  // Catalogue-share / customer-confirmation tracking (see CatalogueStatus).
  catalogueStatus     CatalogueStatus @default(NOT_SENT)
  catalogueShareToken String?         @unique

  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  payments    PartyOrderPayment[]
  items       PartyOrderItem[]

  @@map("party_orders")
}

// Multi-line Party Order support (spec: "no fixed limit such as 5 or 10
// products"). New orders always create these; legacy single-product fields
// on PartyOrder above stay untouched for old rows - identical coexistence
// pattern to CustomerOrder/CustomerOrderItem.
model PartyOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       PartyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  finish      String?
  size        String?
  sizeUnit    String?
  // Pre-set at order creation so the sequential Carpenter -> Carving ->
  // Polish handoff can auto-carry it to the Polish stage's work item -
  // see the identical note on CustomerOrderItem.color.
  color       String?
  pattern     String?
  details     String?
  qty         Int        @default(1)
  unitPrice   Decimal    @db.Decimal(12, 2)
  totalValue  Decimal    @db.Decimal(12, 2) // server-computed qty * unitPrice, never taken from the client

  // This line's own Model No - independent of the order header's cotNo,
  // since one order can now span many products each with their own.
  modelNo            String?
  modelNoUpdatedById String?
  modelNoUpdatedBy   User?     @relation("PartyOrderItemModelNoUpdatedBy", fields: [modelNoUpdatedById], references: [id], onDelete: SetNull)
  modelNoUpdatedAt   DateTime?

  // Stock-first allocation split, computed once at create/edit time by
  // StockAllocationService.allocate().
  stockReservedQty Int @default(0)
  productionQty    Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workItems          CarpenterWorkItem[]
  finishedStockItems FinishedStockItem[]

  @@map("party_order_items")
}

model PartyOrderPayment {
  id      String      @id @default(cuid())
  orderId String
  order   PartyOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date    DateTime
  amount  Decimal     @db.Decimal(12, 2)
  type    PaymentType @default(PARTIAL)
  mode    String?
  note    String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("party_order_payments")
}

// ---------------------------------------------------------------------------
// Sheets 2 & 3: Material Purchase + Payment Ledger (per supplier)
// ---------------------------------------------------------------------------

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique // e.g. "Devi Ply Wood", "Timber Hari"
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases      SupplierPurchase[]
  payments       SupplierPayment[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model SupplierPurchase {
  id          String   @id @default(cuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date        DateTime
  particulars String // e.g. "18mm 8*4 PLYWOOD"
  qty         Decimal? @db.Decimal(12, 2)
  // Unit the qty/price are measured in - e.g. "Sathuram" for round/sawn
  // timber logs (Maghagani, Teakwood), "Sheet" for plywood/chipboard,
  // "Sq.ft" for laminate/veneer. Free text (see src/common/constants/
  // units.constants.ts for the suggested list) rather than a DB enum, since
  // suppliers use varied trade-specific units that shouldn't require a
  // migration to add.
  unit        String?
  price       Decimal? @db.Decimal(12, 2)
  value       Decimal  @db.Decimal(12, 2)

  // Optional link to the RawMaterial this purchase replenishes - null for a
  // lump-sum non-material line (e.g. "RENT"). When set, a paired
  // StockMovement (see StockMovement.supplierPurchaseId) keeps stock in
  // sync automatically; qty/price/value above stay the one authoritative
  // financial record either way.
  rawMaterialId String?
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)

  // Original wood dimensions (inches) - populated only when rawMaterial's
  // measurementKind is BOARD_FEET, kept purely so they stay visible/
  // editable later. qty (=Total Board Feet) and price (=rate/BF) above are
  // the authoritative, server-recomputed values - these four are not.
  thicknessIn Decimal? @db.Decimal(8, 3)
  widthIn     Decimal? @db.Decimal(8, 3)
  lengthIn    Decimal? @db.Decimal(8, 3)
  pieces      Int?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  stockMovements StockMovement[]

  @@map("supplier_purchases")
}

model SupplierPayment {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  date         DateTime
  particulars  String? // e.g. "SSS"
  voucherNo    String?
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal? @db.Decimal(12, 2)
  mode         String? // CASH / GPAY / UPI

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("supplier_payments")
}

// ---------------------------------------------------------------------------
// Sheet 4: Carpenter Work List & Payment
// ---------------------------------------------------------------------------

model Carpenter {
  id         String     @id @default(cuid())
  name       String     @unique
  phone      String?
  workerType WorkerType @default(CARPENTER)
  // Deactivated workers are hidden from the active worker list and can't
  // be assigned new work, but every past CarpenterWorkItem/CarpenterPayment
  // stays intact - the alternative to deleting someone who has real
  // history (deletion itself stays blocked for those, see removeCarpenter).
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Optional link to this worker's own login (Carpenter/Carver/Polisher
  // role User) - lets "My Work" resolve which CarpenterWorkItem rows
  // belong to whoever is signed in. Nullable: a payee can exist purely for
  // payment tracking with no app login at all.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Which named team (of this worker's own workerType) this worker
  // belongs to - e.g. "Carpenter Team A" vs "Carpenter Team B". Optional:
  // a worker with no team keeps working exactly as before (pooled
  // load-balancing across all workers of that type, notifications go to
  // the type-wide WhatsappGroupSetting).
  teamId String?
  team   ProductionTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  workItems     CarpenterWorkItem[]
  payments      CarpenterPayment[]
  weeklyLabours WeeklyLabour[]
  expenses      Expense[]

  @@map("carpenters")
}

// Named grouping of workers within one category (Carpenter/Carving/Polish) -
// e.g. a shop running two independent Carpenter crews. Each team can have
// its own WhatsApp group, so a work-assignment notification for a worker on
// "Team B" goes to Team B's own group rather than one shared group for the
// whole category (WhatsappGroupSetting, kept as the type-wide fallback for
// workers with no team set).
model ProductionTeam {
  id         String     @id @default(cuid())
  name       String
  headUserId String?
  headUser   User?      @relation("ProductionTeamHead", fields: [headUserId], references: [id], onDelete: SetNull)
  workerType WorkerType
  groupId    String?
  groupName  String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  workers Carpenter[]

  @@unique([name, workerType])
  @@map("production_teams")
}

model CarpenterWorkItem {
  id            String              @id @default(cuid())
  carpenterId   String?
  carpenter     Carpenter?          @relation(fields: [carpenterId], references: [id], onDelete: SetNull)
  workDate      DateTime
  modelNo       String? // shared Job/Model Number - links Carpenter -> Carving -> Polish stages and back to CustomerOrder.jobNumber
  stage         ProductionStageType @default(CARPENTER)
  productName   String // e.g. "HEARTEN"
  category      String? // e.g. "BOTTOM COT", "FULL BOX"
  size          String? // e.g. "5"
  sizeUnit      String? // e.g. "FT" - paired with size, same split as CustomerOrder/PartyOrder/Product
  price         Decimal             @db.Decimal(12, 2)
  extra         Decimal             @default(0) @db.Decimal(12, 2)
  quantity      Int                 @default(1)
  total         Decimal             @db.Decimal(12, 2)
  status        WorkStatus          @default(ASSIGNED)
  qcNote        String? // note left when moved to QUALITY_CHECK or REWORK
  photoUrl      String? // uploaded cot / finished-work photo
  labourClaimed Boolean             @default(false) // true once included in a Weekly Labour batch, to prevent double payment

  // Shared across the Carpenter/Carving/Polish rows of one production run -
  // generated once when the first stage is created, copied forward by the
  // automatic stage handoff (see CarpenterService.updateWorkStatus). Null on
  // legacy ad-hoc entries that predate the sequential pipeline.
  batchId    String?
  startedAt  DateTime? // set when status first moves to IN_PROGRESS
  finishedAt DateTime? // set when status moves to COMPLETED (verification, not this stage's own finish)
  notes      String?

  // Which colour to polish this piece - only meaningful at the POLISH
  // stage. Required whenever production is explicitly assigned at Polish
  // (see CarpenterService), so the polish worker always knows what colour
  // to use without having to ask. Null on Carpenter/Carving-stage rows and
  // on a Polish row auto-assigned by the sequential handoff before an
  // Admin has set it (see the "Set Color" action on Production Control).
  color String?

  // Who assigned this stage (distinct from createdById, which also covers a
  // worker's own self-entry) - null for a self-entry or an auto-created
  // handoff stage with no assignee chosen yet.
  assignedById String?
  assignedBy   User?   @relation("WorkItemAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  // Which trigger created this item, and the completion-time bridge target.
  // STOCK (default) -> completing feeds Product.availableQuantity directly
  // (manufacture with no order). CUSTOMER_ORDER/PARTY_ORDER -> completing
  // creates a FinishedStockItem for that job instead, so order-bound
  // production is never double-counted as free stock. See
  // CarpenterService.updateWorkStatus.
  source                 ProductionSource   @default(STOCK)
  sourceCustomerOrderId  String?
  sourceCustomerOrder    CustomerOrder?     @relation(fields: [sourceCustomerOrderId], references: [id], onDelete: SetNull)
  // Which specific line of a multi-product Customer Order this is for -
  // sourceCustomerOrderId alone can't tell two lines of the same order
  // apart, which used to make "Assign to Production" claim whichever
  // line's placeholder happened to be oldest, regardless of which one was
  // actually picked. Mirrors sourcePartyOrderItemId below, which Party
  // Orders already had from the start.
  sourceCustomerOrderItemId String?
  sourceCustomerOrderItem   CustomerOrderItem? @relation(fields: [sourceCustomerOrderItemId], references: [id], onDelete: SetNull)
  sourcePartyOrderItemId String?
  sourcePartyOrderItem   PartyOrderItem?  @relation(fields: [sourcePartyOrderItemId], references: [id], onDelete: SetNull)
  // Which Godown SKU this item's completed output feeds (STOCK source) or
  // gets matched/created against once a Model No is entered.
  productId              String?
  product                Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  stockMovements StockMovement[]
  qualityChecks  QualityCheck[]

  @@map("carpenter_work_items")
}

model CarpenterPayment {
  id          String    @id @default(cuid())
  carpenterId String
  carpenter   Carpenter @relation(fields: [carpenterId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal   @db.Decimal(12, 2)
  mode        String?
  note        String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("carpenter_payments")
}

// ---------------------------------------------------------------------------
// Godown Stock (finished furniture physically on hand). `Product` doubles as
// the Stock Management record - it already carried modelNo/name/category/
// finish/pricing/images, so real stock quantities were added here rather
// than standing up a parallel table. Not a reference-only catalogue: every
// row represents real, physically-produced units.
// ---------------------------------------------------------------------------

model Product {
  id             String   @id @default(cuid())
  sku            String?  @unique
  modelNo        String?  @unique // shared numbering with CustomerOrder.cotTrack / PartyOrder.cotNo - null until Production Employee assigns it
  name           String
  category       String?
  modelSize      String? // e.g. "6x5 ft" (size only - modelNo carries the identifier)
  materialFinish String? // e.g. "Teak - Teak finish"
  sizeUnit       String?
  pattern        String?
  details        String?
  unit           String? // e.g. "Nos", "Set"
  retailPrice    Decimal  @db.Decimal(12, 2) // Unit Price
  wholesalePrice Decimal? @db.Decimal(12, 2)
  costPrice      Decimal? @db.Decimal(12, 2)
  isActive       Boolean  @default(true)

  // Godown stock quantities. quantity = lifetime received; availableQuantity
  // = quantity - reservedQuantity - dispatched, kept as its own counter
  // (not derived) so the concurrency-safe conditional UPDATE in
  // StockAllocationService/ProductsService can check-and-decrement it
  // atomically. reservedQuantity is bookkeeping only - a reservation is
  // immediately materialized as a FinishedStockItem for the owning order,
  // it does not sit "pending" here.
  quantity          Int @default(0)
  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)

  // Links this piece back to the Stock Production run that made it -
  // shared by every unit created from the same multi-unit work item (see
  // CarpenterService.applyCompletionToStock). Lets the worker who actually
  // made a batch find and assign Model Nos to just their own just-produced
  // pieces, without needing full Stock Management access.
  sourceBatchId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             ProductImage[]
  customerOrderItems CustomerOrderItem[]
  partyOrders        PartyOrder[]
  partyOrderItems    PartyOrderItem[]
  workItems          CarpenterWorkItem[]
  stockMovements     ProductStockMovement[]
  finishedStockItems FinishedStockItem[]

  @@index([sourceBatchId])
  @@map("products")
}

// Godown stock movement history - IN (production/manual receive), RESERVED
// (allocated to an order at create time), RELEASED (order cancelled/edited
// before dispatch), DISPATCHED, ADJUSTMENT (manual correction). Separate
// from the raw-material StockMovement model - different domain/unit
// semantics and a different FK target.
model ProductStockMovement {
  id                String                   @id @default(cuid())
  productId         String
  product           Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type              ProductStockMovementType
  quantity          Int
  previousAvailable Int
  newAvailable      Int
  orderType         StockOrderType?
  orderId           String?
  reason            String?

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([productId])
  @@map("product_stock_movements")
}

// Party Order shop/dealer directory - replaces free-text shop names with a
// managed list. Same disable-instead-of-delete-when-in-use pattern as
// ExpenseCategoryService.removeCategory/SuppliersService.remove.
model Shop {
  id           String   @id @default(cuid())
  name         String   @unique
  contactPhone String?
  address      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partyOrders PartyOrder[]

  @@map("shops")
}

// Standalone visual gallery of manufactured furniture photos - images only,
// deliberately NOT a second product catalogue (see GalleryService). Kept
// separate from ProductImage (which is mandatorily tied to one Product/
// stock row): a gallery photo may exist for furniture with no Stock entry
// yet, and modelNo below is an optional free-text label, not a FK, so
// uploading a photo never requires a Stock record to exist first.
model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  fileName  String
  fileSize  Int
  modelNo   String? // optional label only - not a Product FK, see note above
  caption   String?

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  customerOrders CustomerOrderGalleryImage[]

  @@map("gallery_images")
}

// Explicit join table (not Prisma's implicit m2m) - the implicit join
// table's composite key over two cuid columns exceeds MySQL's index
// key-length limit on this database's charset/row format.
model CustomerOrderGalleryImage {
  id             String        @id @default(cuid())
  orderId        String
  order          CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  galleryImageId String
  galleryImage   GalleryImage  @relation(fields: [galleryImageId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  // No composite unique here - two full cuid columns together exceed this
  // database's index key-length limit. Duplicate prevention is handled in
  // CustomerOrdersService (replace-all-on-save), not the DB layer.
  @@index([orderId])
  @@index([galleryImageId])
  @@map("customer_order_gallery_images")
}

// Multiple images per product; the first one created (or the one flagged
// isPrimary) is the catalogue's main image. Stored on local disk under
// apps/api/uploads/products and served statically - the project has no
// object storage, so this reuses the same "local uploads dir" pattern as
// the rest of the app's file handling (PDF generation, WhatsApp media).
model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  fileName  String
  fileSize  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("product_images")
}

// ---------------------------------------------------------------------------
// Raw materials & stock (consumption tracked per carpenter work item)
// ---------------------------------------------------------------------------

model RawMaterial {
  id              String                  @id @default(cuid())
  name            String                  @unique
  type            String? // e.g. "Plywood", "Timber", "Mica", "Hardware", "Thinner", "Sealer"
  materialGroup   MaterialGroup           @default(WOOD) // WOOD -> Carpenter team; POLISH -> Polish team
  // Locks the unit and drives dynamic purchase-math fields - see
  // MaterialMeasurementKind. Defaults to OTHER so every existing row keeps
  // behaving exactly as before (free-text unit) until explicitly set.
  measurementKind MaterialMeasurementKind @default(OTHER)
  unit            String // e.g. "sheet", "cft", "kg", "nos"
  reorderLevel    Decimal?                @db.Decimal(12, 2)
  photoUrl        String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  stockMovements     StockMovement[]
  purchaseOrderItems PurchaseOrderItem[]
  supplierPurchases  SupplierPurchase[]

  @@map("raw_materials")
}

model StockMovement {
  id            String            @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial       @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  type          StockMovementType
  // Signed net change: positive for IN / a positive ADJUSTMENT, negative for
  // OUT / a negative ADJUSTMENT. Current stock = sum(quantity) per material.
  quantity      Decimal           @db.Decimal(12, 2)
  unitCost      Decimal?          @db.Decimal(12, 2) // purchase rate, set on IN movements - ADMIN/CO_ADMIN only in API responses
  reason        String?
  location      String? // stock location / bin, for physical stock-in entries

  workItemId String?
  workItem   CarpenterWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  // Groups every StockMovement created by one PurchaseOrdersService.receive()
  // call - since a PO can be received in multiple partial deliveries, this
  // reconstructs "receiving history" as discrete events (date/who/which
  // lines/how much) without a separate model. Null for movements from any
  // other path (stock-in, issue, adjustment).
  receiptBatchId String?

  // Mirrors purchaseOrderId above - links a material-linked Suppliers
  // purchase to its paired stock-in movement so edit/delete can find and
  // reverse it. Null for movements from PO receive(), stock-in, issue, and
  // adjustment.
  supplierPurchaseId String?
  supplierPurchase   SupplierPurchase? @relation(fields: [supplierPurchaseId], references: [id], onDelete: SetNull)

  date        DateTime
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Purchase orders (approval workflow) - receiving one creates stock IN
// movements and a SupplierPurchase ledger entry for the financial side.
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id              String              @id @default(cuid())
  poNumber        String              @unique
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  status          PurchaseOrderStatus @default(DRAFT)
  orderDate       DateTime
  expectedDate    DateTime?
  notes           String?
  rejectionReason String?
  sentToShopAt    DateTime?

  createdById  String
  createdBy    User      @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("PurchaseOrderApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          PurchaseOrderItem[]
  stockMovements StockMovement[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  rawMaterialId   String
  rawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])
  // Ordered amount - never mutated after create/edit. For a BOARD_FEET
  // material this is the server-computed Total Board Feet, not whatever
  // the client sent (see PurchaseOrdersService).
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  // Running total received so far across every receive() event - lets a PO
  // be received in multiple partial deliveries. quantity - receivedQuantity
  // = remaining still owed.
  receivedQuantity Decimal      @default(0) @db.Decimal(12, 2)

  // Original wood dimensions (inches) - populated only when rawMaterial's
  // measurementKind is BOARD_FEET, kept purely so they stay visible/
  // editable later, same pattern as SupplierPurchase's identical fields.
  thicknessIn Decimal? @db.Decimal(8, 3)
  widthIn     Decimal? @db.Decimal(8, 3)
  lengthIn    Decimal? @db.Decimal(8, 3)
  pieces      Int?

  @@map("purchase_order_items")
}

// ---------------------------------------------------------------------------
// Audit log - security-sensitive events (auth, role/permission changes)
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String? // snapshot, survives user deletion
  action     String // e.g. "LOGIN_SUCCESS", "LOGIN_FAILED", "ROLE_CHANGED", "USER_DEACTIVATED"
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

// Persisted, per-user notifications for Super Admin/Admin (production
// stage events, raw material usage, low stock, verification). One row per
// recipient - a "notify Admin+SuperAdmin" event fans out to one row per
// matching active user, so unread counts and read/unread state are real
// (not the localStorage-only tracking NotificationBell used before this).
model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // e.g. "STAGE_COMPLETED", "MATERIAL_USED", "LOW_STOCK", "READY_FOR_VERIFICATION"
  title      String
  message    String
  targetType String? // e.g. "CarpenterWorkItem", "RawMaterial"
  targetId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Production pipeline: Quality Check -> Finished Stock -> Dispatch -> Delivery
// All keyed off the Job/Model Number (CustomerOrder.jobNumber /
// CarpenterWorkItem.modelNo) so any module can look a job up the same way.
// ---------------------------------------------------------------------------

model QualityCheck {
  id            String             @id @default(cuid())
  jobNumber     String
  workItemId    String?
  workItem      CarpenterWorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  result        QcResult
  checklist     Json?
  remarks       String?
  photoUrl      String?
  inspectedById String
  inspectedBy   User               @relation(fields: [inspectedById], references: [id])
  createdAt     DateTime           @default(now())

  @@index([jobNumber])
  @@map("quality_checks")
}

model FinishedStockItem {
  id             String              @id @default(cuid())
  // Was @unique - dropped so a multi-line Party Order (or a Customer Order
  // whose stock+production split spans two rows) can have more than one
  // finished-stock entry sharing the same job number, one per product line.
  jobNumber      String
  productName    String
  quantity       Int                 @default(1)
  completionDate DateTime
  location       String?
  status         FinishedStockStatus @default(AVAILABLE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Traceability for stock-first order fulfillment (StockAllocationService)
  // - which Godown SKU a reservation was drawn from, and which order/line it
  // is earmarked for, so cancel/edit can release exactly this row rather
  // than guessing from jobNumber alone (one job number can now span many
  // Party Order lines). All optional - manual FinishedStock entries and
  // pre-existing rows simply leave these null; Dispatch itself never reads
  // them.
  productId              String?
  product                Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  sourceCustomerOrderId  String?
  sourceCustomerOrder    CustomerOrder?  @relation(fields: [sourceCustomerOrderId], references: [id], onDelete: SetNull)
  // Which specific line of a multi-product Customer Order this stock-fed
  // unit is for - see the identical note on CarpenterWorkItem.
  sourceCustomerOrderItemId String?
  sourceCustomerOrderItem   CustomerOrderItem? @relation(fields: [sourceCustomerOrderItemId], references: [id], onDelete: SetNull)
  sourcePartyOrderItemId String?
  sourcePartyOrderItem   PartyOrderItem? @relation(fields: [sourcePartyOrderItemId], references: [id], onDelete: SetNull)

  dispatchRecords DispatchRecord[]

  @@index([jobNumber])
  @@map("finished_stock_items")
}

model DispatchRecord {
  id              String             @id @default(cuid())
  jobNumber       String
  finishedStockId String?
  finishedStock   FinishedStockItem? @relation(fields: [finishedStockId], references: [id], onDelete: SetNull)
  dispatchDate    DateTime
  vehicle         String?
  driverName      String?
  driverContact   String?
  remarks         String?
  documentUrl     String?

  dispatchedById String
  dispatchedBy   User     @relation(fields: [dispatchedById], references: [id])
  createdAt      DateTime @default(now())

  @@index([jobNumber])
  @@map("dispatch_records")
}

// ---------------------------------------------------------------------------
// Weekly labour: Carpenter completes jobs -> Co-Admin enters price weekly ->
// Admin reviews/approves -> payment record.
// ---------------------------------------------------------------------------

model WeeklyLabour {
  id                 String       @id @default(cuid())
  carpenterId        String
  carpenter          Carpenter    @relation(fields: [carpenterId], references: [id])
  weekStart          DateTime
  weekEnd            DateTime
  totalCompletedCots Int          @default(0)
  totalLabourAmount  Decimal      @default(0) @db.Decimal(12, 2)
  previousDeduction  Decimal      @default(0) @db.Decimal(12, 2)
  netPayable         Decimal      @default(0) @db.Decimal(12, 2)
  status             LabourStatus @default(DRAFT)
  workItemIds        Json? // snapshot of CarpenterWorkItem ids included in this batch

  submittedById String?
  submittedBy   User?   @relation("WeeklyLabourSubmittedBy", fields: [submittedById], references: [id])
  reviewedById  String?
  reviewedBy    User?   @relation("WeeklyLabourReviewedBy", fields: [reviewedById], references: [id])
  reviewNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("weekly_labours")
}

// ---------------------------------------------------------------------------
// Expenses (Super Admin financial control center) - an independent general
// ledger / cash-book, deliberately NOT reading from or writing to
// SupplierPayment / CarpenterPayment. Those already track purchase and
// wage payments tied to a specific PurchaseOrder / CarpenterWorkItem; this
// module tracks the company's broader outgoing-money log (rent, fuel,
// tolls, one-off cash expenses, personal spending) the way the reference
// paper ledger does. Keeping the two ledgers separate - rather than
// importing supplier/carpenter payments in here - is what prevents an
// entry being counted twice in "Overall Outgoing": each ledger only ever
// sums its own table. See ExpensesService for the full note.
// ---------------------------------------------------------------------------

enum ExpenseScope {
  COMPANY
  PERSONAL
}

enum ExpenseStatus {
  ACTIVE
  ARCHIVED
}

// Configurable category list (Purchase, Salary, Transport, Toll, Company
// Expense, Personal Expense, Rent, ...). Not a hard enum - Super Admin adds
// their own as the business's tracking needs change (see spec's "customizable
// like Todo" requirement).
model ExpenseCategory {
  id                     String                @id @default(cuid())
  name                   String                @unique
  scope                  ExpenseScope? // null = usable for either scope; set = locked to Company or Personal (e.g. "Personal Expense" category is PERSONAL-only)
  defaultReferenceTypeId String?
  defaultReferenceType   ExpenseReferenceType? @relation(fields: [defaultReferenceTypeId], references: [id], onDelete: SetNull)
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  expenses Expense[]

  @@map("expense_categories")
}

// Reference codes shown in the "REF" column of the paper ledger (PUR, SAL,
// TRA, EXP, CMY, EMI, ...). Configurable, not hardcoded.
model ExpenseReferenceType {
  id        String   @id @default(cuid())
  code      String   @unique // short code, e.g. "PUR"
  label     String // e.g. "Purchase"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses   Expense[]
  categories ExpenseCategory[]

  @@map("expense_reference_types")
}

// Payment modes (CASH, UPI-HDFC, IOB, ...). Configurable, separate from the
// free-text `mode` string used on the older Customer/Party/Supplier/Carpenter
// payment models - this one is a managed list Super Admin edits/disables,
// per the spec's "Payment Mode" section.
model ExpensePaymentMode {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@map("expense_payment_modes")
}

model Expense {
  id              String                @id @default(cuid())
  date            DateTime
  voucherNumber   Int                   @unique // sequential, auto-assigned; see ExpensesService.nextVoucherNumber
  referenceTypeId String?
  referenceType   ExpenseReferenceType? @relation(fields: [referenceTypeId], references: [id], onDelete: SetNull)
  categoryId      String
  category        ExpenseCategory       @relation(fields: [categoryId], references: [id])
  particulars     String // what the money was for, e.g. "LOCAL MATTRESS"
  amount          Decimal               @db.Decimal(12, 2)
  paymentModeId   String
  paymentMode     ExpensePaymentMode    @relation(fields: [paymentModeId], references: [id])
  scope           ExpenseScope          @default(COMPANY) // COMPANY vs PERSONAL - see module note above
  paidBy          String? // free text - who physically paid/handled it
  employeeId      String? // optional link to an existing Carpenter (this app's worker/employee registry) for salary-type entries
  employee        Carpenter?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  vendorName      String? // free text vendor/payee, e.g. "HARI TIMBER" - no separate Vendor entity exists in this schema
  description     String?
  notes           String?
  attachmentUrl   String? // receipt/bill upload, reuses the app's existing local-uploads pattern
  tags            String? // comma-separated free tags
  status          ExpenseStatus         @default(ACTIVE)

  createdById String
  createdBy   User     @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  auditLogs ExpenseAuditLog[]

  @@index([date])
  @@index([categoryId])
  @@index([scope])
  @@index([status])
  @@map("expenses")
}

// Change history for financial records - who changed what, old vs new
// value, per the spec's audit requirement. Never silently overwritten.
model ExpenseAuditLog {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action    String // CREATED / UPDATED / ARCHIVED / RESTORED / DELETED
  changes   Json? // { field: { old, new } } for UPDATED
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([expenseId])
  @@map("expense_audit_logs")
}
